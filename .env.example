# =============================================================================
# HOSPITAL WHATSAPP BOT - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in actual values for deployment
# NEVER commit actual values to version control
# =============================================================================

# ---------- SERVER CONFIGURATION ----------
NODE_ENV=production          # Set to 'production' for performance optimizations
PORT=5000                    # Port for the HTTP server
HOST=0.0.0.0                 # Bind to all interfaces (use 127.0.0.1 for localhost only)

# ---------- DATABASE CONFIGURATION ----------
# SQLite database file path (will be created automatically)
DB_PATH=./db/conversations.db

# ---------- AISENSY WHATSAPP CONFIGURATION ----------
# Get these from your hospital's AiSensy account dashboard
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_API_URL=https://api.aisensy.com

# ---------- GOOGLE SHEETS INTEGRATION (PHASE 2) ----------
# Required for doctor availability and report status features
# Follow instructions in docs/google-sheets-setup.md to create service account
GOOGLE_SHEETS_KEY_FILE=./credentials/google-service-account.json

# ---------- CLAUDE API INTEGRATION (PHASE 2) ----------
# Required for free-text question answering
# Get API key from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your_actual_claude_api_key_here

# ---------- LOGGING & MONITORING ----------
LOG_LEVEL=info               # Options: error, warn, info, debug, verbose
ENABLE_METRICS=true          # Enable Prometheus metrics endpoint
METRICS_PORT=9090            # Port for metrics scraping (if ENABLE_METRICS=true)

# ---------- SECURITY & RATE LIMITING ----------
MAX_MESSAGE_LENGTH=500       # Maximum length of incoming WhatsApp messages
RATE_LIMIT_PER_MINUTE=30     # Max messages per minute per phone number
ENABLE_REQUEST_VALIDATION=true # Validate incoming webhook signatures (future)

# ---------- ESCALATION CONFIGURATION ----------
ESCALATION_RETRY_ATTEMPTS=3  # Number of retry attempts for failed notifications
ESCALATION_RETRY_DELAY_MS=60000 # Base delay between retries (exponential backoff)
MAX_ESCALATION_QUEUE_SIZE=1000 # Prevent memory buildup in notification queue

# ---------- DATA RETENTION & PRIVACY ----------
DATA_RETENTION_DAYS=30       # Automatically delete conversation data older than this
ANONYMIZE_LOGS=true          # Strip potential PHI from logs in production
ENABLE_AUDIT_LOG=false       # Set to true if hospital requires audit trail

# ---------- FEATURE FLAGS ----------
ENABLE_DOCTOR_AVAILABILITY=true   # Toggle Google Sheets doctor lookup
ENABLE_REPORT_STATUS=true         # Toggle Google Sheets report lookup
ENABLE_CLAUDE_FALLBACK=true       # Toggle Claude API for free-text questions
ENABLE_ESCALATION_NOTIFICATIONS=true # Toggle external notification sending

# ---------- CUSTOMIZATION ----------
# Hospital-specific settings that might vary by deployment
DEFAULT_LANGUAGE=en          # Default language for responses (en, es, etc.)
TIMEZONE=America/New_York    # Hospital timezone for date/time displays
MAINTENANCE_MODE=false     # Set to true to temporarily disable bot

# ---------- OPENWA WHATSAPP GATEWAY ----------
# For outbound messaging via OpenWA (if used as WhatsApp provider)
OPENWA_BASE_URL=http://localhost:2785   # Base URL of OpenWA instance
OPENWA_API_KEY=your_openwa_api_key_here # API key for OpenWA authentication