# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DB_PATH=./db/conversations.db

# AiSensy (will be overridden per client config for multi-client support)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_API_URL=https://api.aisensy.com/v1

# Claude API (will be used for LLM fallback - Phase 2)
CLAUDE_API_KEY=your_claude_api_key_here

# Logging
LOG_LEVEL=info
