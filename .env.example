# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DB_PATH=./db/conversations.db

# AiSensy (will be overridden per client config for multi-client support)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_API_URL=https://api.aisensy.com/v1

# Claude API (for free-text question answering - Phase 2)
# Leave as placeholder if you don't have a key yet; mock responses will be used
CLAUDE_API_KEY=your_claude_api_key_here

# Google Sheets (Phase 2)
# Service account JSON path or credentials
GOOGLE_SHEETS_KEY_FILE=./credentials/google-sheets-key.json

# Logging
LOG_LEVEL=info

